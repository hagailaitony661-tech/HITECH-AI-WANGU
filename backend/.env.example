# Tengeneza API key yako mwenyewe ya siri; usiweke kwenye GitHub.
HAGAI_API_KEY=badilisha-na-key-ndefu-ya-siri
# URL ya Ollama inayofikiwa na backend.
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Kwa majaribio tu. Katika production, weka origin halisi ya dashboard.
CORS_ORIGINS=*
# Hifadhi ya datasets na SQLite.
HAGAI_DATA_DIR=./data
